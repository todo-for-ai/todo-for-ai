# Todo for AI - 优化的前端 Dockerfile
# 支持多环境构建和灵活配置

# 构建参数
ARG NODE_VERSION=20
ARG NGINX_VERSION=alpine

# ================================
# 前端构建阶段
# ================================
FROM node:${NODE_VERSION}-alpine AS frontend-builder

# 设置工作目录
WORKDIR /app

# 安装构建依赖
RUN apk add --no-cache \
    git \
    python3 \
    make \
    g++

# 复制 package 文件
COPY todo-for-ai-webpage/package*.json ./

# 安装依赖（使用npm ci提高构建速度）
RUN npm ci --only=production --silent

# 复制源代码
COPY todo-for-ai-webpage/ ./

# 构建参数（支持运行时配置）
ARG VITE_API_BASE_URL=http://localhost:50110/todo-for-ai/api/v1
ARG VITE_MCP_SERVER_URL=http://localhost:50110
ARG VITE_APP_TITLE="Todo for AI"
ARG VITE_APP_VERSION="1.0.0"
ARG BUILD_ENV=production

# 设置环境变量
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_MCP_SERVER_URL=$VITE_MCP_SERVER_URL \
    VITE_APP_TITLE=$VITE_APP_TITLE \
    VITE_APP_VERSION=$VITE_APP_VERSION \
    NODE_ENV=$BUILD_ENV

# 构建应用
RUN npm run build:no-check

# 清理构建缓存
RUN npm cache clean --force && \
    rm -rf node_modules

# ================================
# 生产阶段
# ================================
FROM nginx:${NGINX_VERSION} AS production

# 安装必要工具
RUN apk add --no-cache \
    curl \
    jq \
    envsubst

# 创建非root用户
RUN addgroup -g 1001 -S nginx-user && \
    adduser -S -D -H -u 1001 -h /var/cache/nginx -s /sbin/nologin -G nginx-user -g nginx-user nginx-user

# 复制构建结果
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# 复制nginx配置模板
COPY todo-for-ai-webpage/nginx.conf /etc/nginx/nginx.conf.template

# 创建动态配置脚本
RUN cat > /docker-entrypoint.d/30-envsubst-on-templates.sh << 'EOF'
#!/bin/sh
set -e

# 替换nginx配置中的环境变量
envsubst '${API_BASE_URL} ${MCP_SERVER_URL}' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf

# 创建运行时配置文件
cat > /usr/share/nginx/html/config.js << EOL
window.APP_CONFIG = {
  API_BASE_URL: '${API_BASE_URL:-http://localhost:50110/todo-for-ai/api/v1}',
  MCP_SERVER_URL: '${MCP_SERVER_URL:-http://localhost:50110}',
  APP_TITLE: '${APP_TITLE:-Todo for AI}',
  APP_VERSION: '${APP_VERSION:-1.0.0}'
};
EOL

echo "Frontend configuration updated"
EOF

# 设置脚本权限
RUN chmod +x /docker-entrypoint.d/30-envsubst-on-templates.sh

# 设置默认环境变量
ENV API_BASE_URL=http://localhost:50110/todo-for-ai/api/v1 \
    MCP_SERVER_URL=http://localhost:50110 \
    APP_TITLE="Todo for AI" \
    APP_VERSION="1.0.0"

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/ || exit 1

# 暴露端口
EXPOSE 80

# 设置用户
USER nginx-user

# 启动命令
CMD ["nginx", "-g", "daemon off;"]
