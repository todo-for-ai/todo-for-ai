# Todo for AI 私有部署环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ===========================================
# 基础配置
# ===========================================

# 私有部署的基础URL (必需)
# 格式: http://your-domain-or-ip:port 或 https://your-domain.com
BASE_URL=http://localhost:50111

# 端口配置
API_PORT=50110
FRONTEND_PORT=50111
HTTP_PORT=80
HTTPS_PORT=443

# ===========================================
# 数据库配置
# ===========================================

# MySQL配置
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=todo_for_ai
MYSQL_USER=todo_user
MYSQL_PASSWORD=your_secure_mysql_password_here
MYSQL_PORT=3306

# ===========================================
# 安全密钥配置 (必需)
# ===========================================

# Flask会话密钥 (32位以上随机字符串)
# 生成方法: openssl rand -hex 32
SECRET_KEY=your_secret_key_32_chars_or_more_here

# JWT令牌签名密钥 (32位以上随机字符串)
# 生成方法: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_32_chars_or_more_here

# ===========================================
# OAuth配置 (必需)
# ===========================================

# GitHub OAuth应用配置
# 创建地址: https://github.com/settings/developers
# 回调URL: {BASE_URL}/todo-for-ai/api/v1/auth/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth应用配置 (可选)
# 创建地址: https://console.cloud.google.com/
# 回调URL: {BASE_URL}/todo-for-ai/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===========================================
# Redis配置 (可选)
# ===========================================

# Redis缓存服务配置
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ===========================================
# 应用配置
# ===========================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 环境标识 (保持为true)
DOCKER_ENV=true

# ===========================================
# SSL证书配置 (使用Nginx时)
# ===========================================

# SSL证书文件路径 (相对于docker-compose.yml)
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# ===========================================
# 备份配置
# ===========================================

# 备份存储路径
BACKUP_PATH=./backups

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# ===========================================
# 监控配置
# ===========================================

# 健康检查间隔 (秒)
HEALTH_CHECK_INTERVAL=30

# 健康检查超时 (秒)
HEALTH_CHECK_TIMEOUT=10

# ===========================================
# 性能配置
# ===========================================

# 数据库连接池大小
DB_POOL_SIZE=10

# 数据库连接池最大溢出
DB_MAX_OVERFLOW=20

# 数据库连接超时 (秒)
DB_POOL_TIMEOUT=30

# ===========================================
# 开发配置 (生产环境请删除或注释)
# ===========================================

# 开发模式 (生产环境设为false)
DEBUG=false

# 允许的主机 (生产环境请设置具体域名)
ALLOWED_HOSTS=*

# ===========================================
# 配置说明
# ===========================================

# 1. 必需配置项:
#    - BASE_URL: 私有部署的访问地址
#    - SECRET_KEY: Flask会话密钥
#    - JWT_SECRET_KEY: JWT令牌签名密钥
#    - GITHUB_CLIENT_ID: GitHub OAuth客户端ID
#    - GITHUB_CLIENT_SECRET: GitHub OAuth客户端密钥
#    - MYSQL_PASSWORD: MySQL数据库密码

# 2. 密钥生成方法:
#    openssl rand -hex 32

# 3. OAuth应用创建:
#    GitHub: https://github.com/settings/developers
#    Google: https://console.cloud.google.com/

# 4. 回调URL配置:
#    GitHub: {BASE_URL}/todo-for-ai/api/v1/auth/callback
#    Google: {BASE_URL}/todo-for-ai/api/v1/auth/google/callback

# 5. 安全建议:
#    - 使用强密码
#    - 定期更换密钥
#    - 不要将此文件提交到版本控制系统
#    - 生产环境使用HTTPS

# 6. 部署命令:
#    # 基础部署
#    docker-compose -f docker-compose.private.yml up -d
#
#    # 包含Redis缓存
#    docker-compose -f docker-compose.private.yml --profile with-redis up -d
#
#    # 包含Nginx反向代理
#    docker-compose -f docker-compose.private.yml --profile with-nginx up -d
#
#    # 完整部署
#    docker-compose -f docker-compose.private.yml --profile with-redis --profile with-nginx up -d

# 7. MCP配置（私有部署）:
#    私有部署后，MCP配置需要指向私有部署的API端点：
#
#    Claude Desktop配置示例：
#    {
#      "mcpServers": {
#        "todo-for-ai": {
#          "command": "npx",
#          "args": [
#            "--yes",
#            "@todo-for-ai/mcp@latest",
#            "--api-base-url",
#            "http://your-domain:50110/todo-for-ai/api/v1",
#            "--api-token",
#            "your-api-token-here"
#          ]
#        }
#      }
#    }
#
#    注意：
#    - API端点使用50110端口（不是50111）
#    - 需要在Web界面创建API Token
#    - 配置后需要重启AI客户端
