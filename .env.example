# Todo for AI - 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# ================================
# 数据库配置
# ================================
# 数据库连接URL（必需）
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/todo_for_ai

# 测试数据库URL（可选，用于测试环境）
# TEST_DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/todo_for_ai_test

# ================================
# 应用安全配置
# ================================
# Flask应用密钥（必需，生产环境请使用强密码）
SECRET_KEY=your-secret-key-here-change-in-production

# JWT令牌密钥（用于用户登录认证）
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# ================================
# OAuth登录配置（可选）
# ================================
# GitHub OAuth（用于GitHub登录）
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth（用于Google登录）
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ================================
# CORS跨域配置
# ================================
# 允许的跨域来源（开发环境必需，多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:50111,http://localhost:50112

# ================================
# 文件上传配置
# ================================
# 上传文件存储目录
UPLOAD_FOLDER=uploads
# 最大上传文件大小（字节，默认16MB）
MAX_CONTENT_LENGTH=16777216

# 日志级别
# LOG_LEVEL=INFO
# LOG_FILE=app.log
