<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 服务标识符 -->
    <key>Label</key>
    <string>com.todoforai.service</string>
    
    <!-- 程序路径和参数 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/usr/local/bin/todoforai-service.sh</string>
    </array>
    
    <!-- 工作目录 -->
    <key>WorkingDirectory</key>
    <string>/usr/local/share/todoforai</string>
    
    <!-- 开机自启动 -->
    <key>RunAtLoad</key>
    <true/>
    
    <!-- 保持运行状态 -->
    <key>KeepAlive</key>
    <dict>
        <!-- 如果进程意外退出，自动重启 -->
        <key>SuccessfulExit</key>
        <false/>
        <!-- 每30秒检查一次进程状态 -->
        <key>Crashed</key>
        <true/>
    </dict>
    
    <!-- 标准输出日志 -->
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/todoforai/service.log</string>
    
    <!-- 标准错误日志 -->
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/todoforai/service-error.log</string>
    
    <!-- 环境变量 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/usr/local/share/todoforai</string>
        <key>TODOFORAI_SERVICE_MODE</key>
        <string>daemon</string>
    </dict>
    
    <!-- 用户和组 -->
    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>wheel</string>
    
    <!-- 进程限制 -->
    <key>SoftResourceLimits</key>
    <dict>
        <!-- 最大文件描述符数量 -->
        <key>NumberOfFiles</key>
        <integer>1024</integer>
        <!-- 最大进程数量 -->
        <key>NumberOfProcesses</key>
        <integer>100</integer>
    </dict>
    
    <!-- 移除网络访问权限配置，让应用自己管理端口 -->
    
    <!-- 启动延迟（秒） -->
    <key>StartInterval</key>
    <integer>10</integer>
    
    <!-- 超时设置 -->
    <key>TimeOut</key>
    <integer>30</integer>
    
    <!-- 退出超时 -->
    <key>ExitTimeOut</key>
    <integer>20</integer>
    
    <!-- 禁用在安全模式下运行 -->
    <key>Disabled</key>
    <false/>
    
    <!-- 启用调试模式 -->
    <key>Debug</key>
    <false/>
</dict>
</plist>
